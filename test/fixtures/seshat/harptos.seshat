BEGIN:VCALENDAR
SESHAT:1
NAME:Harptos

BEGIN:VGEAR
UID:shieldmeet
RRULE:FREQ=year;INTERVAL=4;OFFSET=-1
END:VGEAR

BEGIN:VUNIT
UID:year
ANCHOR:D0
LENGTH:365
GEAR:shieldmeet*1
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Hammer=30
BEGIN:VSLOT
NAME:Midwinter
LENGTH:1
FILLER:TRUE
END:VSLOT
SLOT:Alturiak=30
SLOT:Ches=30
SLOT:Tarsakh=30
BEGIN:VSLOT
NAME:Greengrass
LENGTH:1
FILLER:TRUE
END:VSLOT
SLOT:Mirtul=30
SLOT:Kythorn=30
SLOT:Flamerule=30
BEGIN:VSLOT
NAME:Midsummer
LENGTH:1
FILLER:TRUE
END:VSLOT
BEGIN:VSLOT
NAME:Shieldmeet
LENGTH:0
GEAR:shieldmeet*1
FILLER:TRUE
END:VSLOT
SLOT:Eleasis=30
SLOT:Eleint=30
BEGIN:VSLOT
NAME:Highharvestide
LENGTH:1
FILLER:TRUE
END:VSLOT
SLOT:Marpenoth=30
SLOT:Uktar=30
BEGIN:VSLOT
NAME:Feast of the Moon
LENGTH:1
FILLER:TRUE
END:VSLOT
SLOT:Nightal=30
END:VUNIT

BEGIN:VUNIT
UID:tenday
IN:month
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
END:VUNIT

END:VCALENDAR
