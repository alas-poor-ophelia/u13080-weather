BEGIN:VCALENDAR
SESHAT:1
NAME:French Republican (equinox rule)
FORMAT:default={month\:day} {month\:name} An {year}

BEGIN:VUNIT
UID:year
NUMBER:1
CROSSING:18262101/50000@D-64748+1117/2880
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Vendémiaire=30
SLOT:Brumaire=30
SLOT:Frimaire=30
SLOT:Nivôse=30
SLOT:Pluviôse=30
SLOT:Ventôse=30
SLOT:Germinal=30
SLOT:Floréal=30
SLOT:Prairial=30
SLOT:Messidor=30
SLOT:Thermidor=30
SLOT:Fructidor=30
BEGIN:VSLOT
NAME:Sansculottides
LENGTH:SLACK
FILLER:TRUE
END:VSLOT
END:VUNIT

BEGIN:VUNIT
UID:decade
IN:month
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
END:VUNIT

END:VCALENDAR
