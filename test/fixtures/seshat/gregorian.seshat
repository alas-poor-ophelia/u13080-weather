BEGIN:VCALENDAR
SESHAT:1
NAME:Gregorian
FORMAT:default={year}-{month\:pad2}-{month\:day\:pad2}
FORMAT:long={weekday\:name} {month\:day} {month\:name} {year}

BEGIN:VGEAR
UID:leap
RRULE:FREQ=year;INTERVAL=4
EXRULE:FREQ=year;INTERVAL=100
RRULE:FREQ=year;INTERVAL=400
END:VGEAR

BEGIN:VUNIT
UID:year
ANCHOR:D-719528
LENGTH:365
GEAR:leap*1
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:January=31
BEGIN:VSLOT
NAME:February
LENGTH:SLACK
END:VSLOT
SLOT:March=31
SLOT:April=30
SLOT:May=31
SLOT:June=30
SLOT:July=31
SLOT:August=31
SLOT:September=30
SLOT:October=31
SLOT:November=30
SLOT:December=31
END:VUNIT

BEGIN:VUNIT
UID:week
ANCHOR:D3
LENGTH:7
END:VUNIT

BEGIN:VUNIT
UID:weekday
ANCHOR:D3
LENGTH:1
LABEL:Sunday
LABEL:Monday
LABEL:Tuesday
LABEL:Wednesday
LABEL:Thursday
LABEL:Friday
LABEL:Saturday
END:VUNIT

END:VCALENDAR
