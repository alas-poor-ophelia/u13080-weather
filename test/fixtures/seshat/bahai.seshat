BEGIN:VCALENDAR
SESHAT:1
NAME:Baháʼí (Badíʻ)

BEGIN:VGEAR
UID:leap
RRULE:FREQ=year;INTERVAL=4;OFFSET=3
EXRULE:FREQ=year;INTERVAL=100;OFFSET=55
RRULE:FREQ=year;INTERVAL=400;OFFSET=155
END:VGEAR

BEGIN:VUNIT
UID:year
ANCHOR:D-45941
LENGTH:365
GEAR:leap*1
BEGIN:VSWITCH
FROM:171
CROSSING:36524237/100000@D-45942+266419/300000
END:VSWITCH
STARTS:FROM=182;ON=D20533
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Bahá=19
