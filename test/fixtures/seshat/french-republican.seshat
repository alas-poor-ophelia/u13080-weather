BEGIN:VCALENDAR
SESHAT:1
NAME:French Republican (Romme)

BEGIN:VGEAR
UID:leap
RRULE:FREQ=year;INTERVAL=4;OFFSET=-1
EXRULE:FREQ=year;INTERVAL=100;OFFSET=-1
RRULE:FREQ=year;INTERVAL=400;OFFSET=-1
EXRULE:FREQ=year;INTERVAL=4000;OFFSET=-1
END:VGEAR

BEGIN:VUNIT
UID:year
ANCHOR:D-64748
LENGTH:365
GEAR:leap*1
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Vendémiaire=30
SLOT:Brumaire=30
SLOT:Frimaire=30
SLOT:Nivôse=30
SLOT:Pluviôse=30
SLOT:Ventôse=30
SLOT:Germinal=30
SLOT:Floréal=30
SLOT:Prairial=30
SLOT:Messidor=30
SLOT:Thermidor=30
SLOT:Fructidor=30
BEGIN:VSLOT
NAME:Sansculottides
LENGTH:SLACK
FILLER:TRUE
END:VSLOT
END:VUNIT

BEGIN:VUNIT
UID:decade
IN:month
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
BEGIN:VSLOT
LENGTH:10
END:VSLOT
END:VUNIT

END:VCALENDAR
