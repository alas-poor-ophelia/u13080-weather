BEGIN:VCALENDAR
SESHAT:1
NAME:Ethiopian
FORMAT:default={month\:day} {month\:name} {year}

BEGIN:VGEAR
UID:leap
RRULE:FREQ=year;INTERVAL=4;OFFSET=2
END:VGEAR

BEGIN:VUNIT
UID:year
NUMBER:1
ANCHOR:D-716367
LENGTH:365
GEAR:leap*1
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Meskerem=30
SLOT:Tikimt=30
SLOT:Hidar=30
SLOT:Tahsas=30
SLOT:Tir=30
SLOT:Yekatit=30
SLOT:Megabit=30
SLOT:Miyazya=30
SLOT:Ginbot=30
SLOT:Sene=30
SLOT:Hamle=30
SLOT:Nehase=30
BEGIN:VSLOT
NAME:Pagume
LENGTH:SLACK
END:VSLOT
END:VUNIT

END:VCALENDAR
