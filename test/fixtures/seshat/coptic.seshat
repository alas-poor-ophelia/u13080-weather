BEGIN:VCALENDAR
SESHAT:1
NAME:Coptic

BEGIN:VGEAR
UID:leap
RRULE:FREQ=year;INTERVAL=4;OFFSET=2
END:VGEAR

BEGIN:VUNIT
UID:year
ANCHOR:D-615558
LENGTH:365
GEAR:leap*1
END:VUNIT

BEGIN:VUNIT
UID:month
IN:year
SLOT:Thout=30
SLOT:Paopi=30
SLOT:Hathor=30
SLOT:Koiak=30
SLOT:Tobi=30
SLOT:Meshir=30
SLOT:Paremhat=30
SLOT:Parmouti=30
SLOT:Pashons=30
SLOT:Paoni=30
SLOT:Epip=30
SLOT:Mesori=30
BEGIN:VSLOT
NAME:Pi Kogi Enavot
LENGTH:SLACK
END:VSLOT
END:VUNIT

END:VCALENDAR
